set(output "#pragma once\nstruct PieceAsset { const unsigned char* data; int size; };\n")
set(entries "{nullptr,0}")
set(index 0)
foreach(side White Black)
    foreach(piece Pawn Knight Bishop Rook Queen King)
        math(EXPR index "${index}+1")
        file(READ "${CMAKE_SOURCE_DIR}/ChessApplication/Images/${side} ${piece}.png" data HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," data "${data}")
        string(APPEND output "static const unsigned char piece${index}[]={${data}};\n")
        string(APPEND entries ",{piece${index},sizeof(piece${index})}")
    endforeach()
endforeach()
string(APPEND output "static const PieceAsset pieceAssets[]={${entries}};\n")
file(WRITE "${CMAKE_BINARY_DIR}/PieceAssets.h" "${output}")
