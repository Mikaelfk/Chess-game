set(output "#pragma once\nstruct PieceAsset { const unsigned char* data; int size; };\n")
set(entries "{}")
set(index 0)
foreach(side White Black)
    foreach(piece Pawn Knight Bishop Rook Queen King)
        math(EXPR index "${index}+1")
        set(levels "")
        foreach(size 32 64 128 256 512)
            if(size EQUAL 512)
                set(path "${CMAKE_SOURCE_DIR}/Assets/Pieces/${side} ${piece}.png")
            else()
                set(path "${CMAKE_SOURCE_DIR}/Assets/Pieces/mip/${size}/${side} ${piece}.png")
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
            file(READ "${path}" data HEX)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," data "${data}")
            string(APPEND output "static const unsigned char piece${index}_${size}[]={${data}};\n")
            string(APPEND levels "{piece${index}_${size},sizeof(piece${index}_${size})},")
        endforeach()
        string(APPEND entries ",{${levels}}")
    endforeach()
endforeach()
string(APPEND output "static const PieceAsset pieceAssets[13][5]={${entries}};\n")
file(WRITE "${CMAKE_BINARY_DIR}/PieceAssets.h" "${output}")
